<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvTituloEstimulada"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PESQUISA ESTIMULADA"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginTop="60dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvPerguntaEstimulada"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Entre as opções abaixo, em quem você votaria?"
        android:textSize="18sp"
        android:gravity="center"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/tvTituloEstimulada"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <RadioGroup
        android:id="@+id/rgCandidatos"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/tvPerguntaEstimulada"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <RadioButton
            android:id="@+id/rbCandidato1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Candidato 1" />

        <RadioButton
            android:id="@+id/rbCandidato2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Candidato 2" />

        <RadioButton
            android:id="@+id/rbCandidato3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Candidato 3" />

        <RadioButton
            android:id="@+id/rbCandidato4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Candidato 4" />

        <RadioButton
            android:id="@+id/rbCandidato5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Candidato 5" />

    </RadioGroup>

    <Button
        android:id="@+id/btnConfirmarEstimulada"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Confirmar"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/rgCandidatos"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvErroEstimulada"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#D32F2F"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/btnConfirmarEstimulada"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>