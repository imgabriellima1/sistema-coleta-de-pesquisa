<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvTituloEspontanea"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PESQUISA ESPONTÂNEA"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginTop="60dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvPerguntaEspontanea"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Se a eleição fosse hoje, em quem você votaria?"
        android:textSize="18sp"
        android:gravity="center"
        android:layout_marginTop="40dp"
        app:layout_constraintTop_toBottomOf="@id/tvTituloEspontanea"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <EditText
        android:id="@+id/etCandidatoEspontaneo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Digite o nome informado"
        android:inputType="textCapWords"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/tvPerguntaEspontanea"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/btnConfirmarEspontanea"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Confirmar"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/etCandidatoEspontaneo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvErroEspontanea"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#D32F2F"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/btnConfirmarEspontanea"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>